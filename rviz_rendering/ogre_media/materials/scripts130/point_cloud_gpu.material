    {
      alpha_rejection greater_equal 1
      vertex_program_ref rviz/glsl130/point_cloud_gpu_billboard.vert(with_depth) {}
      fragment_program_ref rviz/glsl120/depth.frag {}
    }
  }
  technique gpu_selection_first_pass
  {
    scheme Pick
    pass
    {
      vertex_program_ref rviz/glsl130/point_cloud_gpu_billboard.vert(pick) {}
      fragment_program_ref rviz/glsl120/pickcolor.frag {}
