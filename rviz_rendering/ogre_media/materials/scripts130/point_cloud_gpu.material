  }
  technique gpu
  {
    pass
    {
      alpha_rejection greater_equal 1
      vertex_program_ref rviz/glsl130/point_cloud_gpu_billboard.vert {}
      fragment_program_ref rviz/glsl120/smooth_square.frag {}
